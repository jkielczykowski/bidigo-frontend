# Copy to .env for local development and manual deploys (never commit .env).
# In GitHub Actions the same values come from repository secrets — see .github/SECRETS.md.

VITE_SUPABASE_URL=https://<REF>.supabase.co
VITE_SUPABASE_ANON_KEY=
# Optional: Cloudflare Turnstile site key; empty = no captcha on sign-up
VITE_TURNSTILE_SITE_KEY=
